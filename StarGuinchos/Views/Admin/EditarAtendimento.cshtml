@model StarGuinchos.ViewModels.AtendimentoEditViewModel

@{
    ViewData["Title"] = "Editar atendimento";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<section class="admin-edit-page">
    <div class="admin-edit-page__container">

        <header class="admin-edit-header">
            <div>
                <span class="admin-page__eyebrow">Área administrativa</span>
                <h1 class="admin-edit-header__title">Editar atendimento</h1>
                <p class="admin-edit-header__text">
                    Atualize as informações, substitua a imagem e ajuste o enquadramento da foto exibida no site.
                </p>
            </div>

            <div class="admin-edit-header__actions">
                <a asp-controller="Admin" asp-action="Index" class="admin-action-btn admin-action-btn--dark">
                    Dashboard
                </a>

                <a asp-controller="Admin" asp-action="Atendimentos" class="admin-action-btn admin-action-btn--ghost">
                    Voltar
                </a>
            </div>
        </header>

        <form asp-controller="Admin"
              asp-action="EditarAtendimento"
              asp-route-id="@Model.Id"
              method="post"
              enctype="multipart/form-data"
              class="admin-edit-layout">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <aside class="admin-edit-preview-card">
                <div class="admin-edit-preview-card__top">
                    <div>
                        <span class="admin-edit-preview-card__label">Pré-visualização</span>
                        <h2 class="admin-edit-preview-card__title">Imagem do atendimento</h2>
                    </div>
                </div>

                <div class="admin-edit-preview">
                    @if (!string.IsNullOrWhiteSpace(Model.ImagemUrlAtual))
                    {
                        <img id="attendancePreviewImage"
                             src="@Model.ImagemUrlAtual"
                             alt="Imagem atual do atendimento"
                             style="object-position: @Model.PosicaoX% @Model.PosicaoY%; transform: scale(@Model.Zoom.ToString(System.Globalization.CultureInfo.InvariantCulture));" />
                    }
                    else
                    {
                        <div class="admin-edit-preview__empty">
                            Nenhuma imagem cadastrada
                        </div>
                    }
                </div>

                <div class="admin-edit-current-info">
                    <span>Imagem atual</span>
                    <strong>@(!string.IsNullOrWhiteSpace(Model.ImagemUrlAtual) ? "Arquivo carregado" : "Sem imagem")</strong>
                </div>

                <div class="admin-edit-note">
                    <strong>Dica:</strong>
                    use os controles de posição e zoom para deixar o caminhão ou veículo bem enquadrado no card público.
                </div>
            </aside>

            <main class="admin-edit-form-card">
                <div class="admin-edit-form-card__header">
                    <span class="admin-edit-form-card__badge">Informações</span>
                    <h2>Dados do atendimento</h2>
                    <p>
                        Esses dados aparecem na área pública de atendimentos realizados.
                    </p>
                </div>

                <div asp-validation-summary="ModelOnly" class="admin-validation-summary"></div>

                <div class="admin-form-grid">
                    <div class="admin-field admin-field--full">
                        <label asp-for="Imagem">Substituir imagem</label>

                        <label class="admin-file-upload">
                            <input asp-for="Imagem" type="file" accept=".jpg,.jpeg,.png,.webp" id="Imagem" />
                            <span class="admin-file-upload__icon">+</span>
                            <span>
                                <strong>Selecionar nova foto</strong>
                                <small>JPG, JPEG, PNG ou WEBP</small>
                            </span>
                        </label>

                        <span asp-validation-for="Imagem" class="admin-field-error"></span>
                    </div>

                    <div class="admin-field">
                        <label asp-for="Titulo">Título</label>
                        <input asp-for="Titulo" placeholder="Ex: Remoção de veículo" />
                        <span asp-validation-for="Titulo" class="admin-field-error"></span>
                    </div>

                    <div class="admin-field">
                        <label asp-for="Categoria">Categoria</label>
                        <input asp-for="Categoria" placeholder="Ex: Guincho, carro de passeio..." />
                        <span asp-validation-for="Categoria" class="admin-field-error"></span>
                    </div>

                    <div class="admin-field admin-field--full">
                        <label asp-for="Descricao">Descrição</label>
                        <textarea asp-for="Descricao" rows="5" placeholder="Descreva brevemente o atendimento realizado"></textarea>
                        <span asp-validation-for="Descricao" class="admin-field-error"></span>
                    </div>
                </div>

                <div class="admin-edit-adjustments">
                    <div class="admin-edit-adjustments__header">
                        <div>
                            <span class="admin-edit-form-card__badge">Enquadramento</span>
                            <h3>Ajuste da imagem</h3>
                        </div>
                    </div>

                    <div class="admin-range-grid">
                        <div class="admin-range-field">
                            <div class="admin-range-field__top">
                                <label asp-for="PosicaoX">Horizontal</label>
                                <span id="posicaoXValue">@Model.PosicaoX%</span>
                            </div>
                            <input asp-for="PosicaoX" type="range" min="0" max="100" id="PosicaoX" />
                        </div>

                        <div class="admin-range-field">
                            <div class="admin-range-field__top">
                                <label asp-for="PosicaoY">Vertical</label>
                                <span id="posicaoYValue">@Model.PosicaoY%</span>
                            </div>
                            <input asp-for="PosicaoY" type="range" min="0" max="100" id="PosicaoY" />
                        </div>

                        <div class="admin-range-field admin-range-field--full">
                            <div class="admin-range-field__top">
                                <label asp-for="Zoom">Zoom</label>
                                <span id="zoomValue">@Model.Zoom.ToString("0.0")x</span>
                            </div>
                            <input asp-for="Zoom" type="range" min="1" max="2.5" step="0.1" id="Zoom" />
                        </div>
                    </div>
                </div>

                <div class="admin-edit-form-actions">
                    <a asp-controller="Admin" asp-action="Atendimentos" class="admin-action-btn admin-action-btn--ghost">
                        Cancelar
                    </a>

                    <button type="submit" class="admin-action-btn admin-action-btn--save">
                        Salvar alterações
                    </button>
                </div>
            </main>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const imageInput = document.getElementById("Imagem");
            const previewImage = document.getElementById("attendancePreviewImage");

            const posicaoX = document.getElementById("PosicaoX");
            const posicaoY = document.getElementById("PosicaoY");
            const zoom = document.getElementById("Zoom");

            const posicaoXValue = document.getElementById("posicaoXValue");
            const posicaoYValue = document.getElementById("posicaoYValue");
            const zoomValue = document.getElementById("zoomValue");

            function updatePreview() {
                if (!previewImage) return;

                const x = posicaoX ? posicaoX.value : 50;
                const y = posicaoY ? posicaoY.value : 50;
                const z = zoom ? zoom.value : 1;

                previewImage.style.objectPosition = `${x}% ${y}%`;
                previewImage.style.transform = `scale(${z})`;

                if (posicaoXValue) posicaoXValue.textContent = `${x}%`;
                if (posicaoYValue) posicaoYValue.textContent = `${y}%`;
                if (zoomValue) zoomValue.textContent = `${Number(z).toFixed(1)}x`;
            }

            if (posicaoX) posicaoX.addEventListener("input", updatePreview);
            if (posicaoY) posicaoY.addEventListener("input", updatePreview);
            if (zoom) zoom.addEventListener("input", updatePreview);

            if (imageInput && previewImage) {
                imageInput.addEventListener("change", function () {
                    const file = imageInput.files && imageInput.files[0];

                    if (!file) return;

                    const reader = new FileReader();

                    reader.onload = function (event) {
                        previewImage.src = event.target.result;
                    };

                    reader.readAsDataURL(file);
                });
            }
        });
    </script>
}