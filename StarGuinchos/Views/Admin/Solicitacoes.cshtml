@model List<StarGuinchos.Models.Solicitacao>

@{
    ViewData["Title"] = "Solicitações";
}

<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<section class="admin-dashboard">
    <aside class="admin-sidebar">
        <div class="admin-sidebar__brand">
            <h1>StarGuinchos</h1>
            <span>Admin Panel</span>
        </div>

        <nav class="admin-sidebar__nav">
            <a asp-controller="Admin" asp-action="Index" class="admin-sidebar__link">
                Dashboard
            </a>

            <a asp-controller="Admin" asp-action="Solicitacoes" class="admin-sidebar__link active">
                Solicitações
            </a>
        </nav>
    </aside>

    <main class="admin-content">
        <header class="admin-topbar">
            <div>
                <p class="admin-topbar__eyebrow">Operação</p>
                <h2>Solicitações recebidas</h2>
            </div>

            <a asp-controller="Admin" asp-action="Index" class="admin-topbar__button">
                Voltar ao dashboard
            </a>
        </header>

        @if (TempData["AdminMensagem"] != null)
        {
            <div class="admin-alert">
                @TempData["AdminMensagem"]
            </div>
        }

        <section class="admin-table-panel">
            <div class="admin-table-panel__header">
                <div>
                    <p class="admin-panel__eyebrow">Listagem completa</p>
                    <h3>Gerencie e acompanhe os serviços</h3>
                </div>

                <div class="admin-table-panel__count">
                    Total filtrado: <strong>@Model.Count</strong>
                </div>
            </div>

            <form method="get" asp-controller="Admin" asp-action="Solicitacoes" class="admin-filters">
                <div class="admin-filter-group admin-filter-group--search">
                    <label for="busca" class="admin-filter-label">Busca</label>
                    <input type="text"
                           id="busca"
                           name="busca"
                           value="@ViewBag.Busca"
                           class="admin-input"
                           placeholder="Nome, telefone ou veículo" />
                </div>

                <div class="admin-filter-group">
                    <label for="status" class="admin-filter-label">Status</label>
                    <select id="status" name="status" class="admin-select">
                        <option value="">Todos</option>
                        <option value="novo" selected="@(ViewBag.Status == "novo")">novo</option>
                        <option value="em andamento" selected="@(ViewBag.Status == "em andamento")">em andamento</option>
                        <option value="concluido" selected="@(ViewBag.Status == "concluido")">concluido</option>
                        <option value="cancelado" selected="@(ViewBag.Status == "cancelado")">cancelado</option>
                    </select>
                </div>

                <div class="admin-filter-group">
                    <label for="data" class="admin-filter-label">Data</label>
                    <input type="date"
                           id="data"
                           name="data"
                           value="@ViewBag.Data"
                           class="admin-input" />
                </div>

                <div class="admin-filter-actions">
                    <button type="submit" class="admin-action-button admin-action-button--save">
                        Filtrar
                    </button>

                    <a asp-controller="Admin"
                           asp-action="Solicitacoes"
                           class="admin-action-button admin-action-button--clear">
                        Limpar
                    </a>
                </div>
            </form>

            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Telefone</th>
                            <th>Veículo</th>
                            <th>Problema</th>
                            <th>Origem</th>
                            <th>Destino</th>
                            <th>Data</th>
                            <th>Status</th>
                            <th>Atualizar</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var s in Model)
                        {
                            var statusAtual = (s.Status_solicitacao ?? "novo").ToLower();

                            var statusClass = statusAtual switch
                            {
                                "novo" => "admin-badge admin-badge--novo",
                                "em andamento" => "admin-badge admin-badge--andamento",
                                "concluido" => "admin-badge admin-badge--concluido",
                                "cancelado" => "admin-badge admin-badge--cancelado",
                                _ => "admin-badge"
                            };

                            <tr>
                                <td>#@s.Id</td>
                                <td>@s.Nome</td>
                                <td>@s.Telefone</td>
                                <td>@s.Veiculo</td>
                                <td>@s.Problema</td>
                                <td>@s.Ponto_partida</td>
                                <td>@s.Destino</td>
                                <td>@s.Data_solicitacao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="@statusClass">@statusAtual</span>
                                </td>
                                <td>
                                    <form asp-controller="Admin"
                                          asp-action="AtualizarStatus"
                                          asp-route-id="@s.Id"
                                          method="post"
                                          class="admin-status-form">
                                        @Html.AntiForgeryToken()

                                        <select name="novoStatus" class="admin-select">
                                            @if (statusAtual == "novo")
                                            {
                                                <option value="novo" selected>novo</option>
                                            }
                                            else
                                            {
                                                <option value="novo">novo</option>
                                            }

                                            @if (statusAtual == "em andamento")
                                            {
                                                <option value="em andamento" selected>em andamento</option>
                                            }
                                            else
                                            {
                                                <option value="em andamento">em andamento</option>
                                            }

                                            @if (statusAtual == "concluido")
                                            {
                                                <option value="concluido" selected>concluido</option>
                                            }
                                            else
                                            {
                                                <option value="concluido">concluido</option>
                                            }

                                            @if (statusAtual == "cancelado")
                                            {
                                                <option value="cancelado" selected>cancelado</option>
                                            }
                                            else
                                            {
                                                <option value="cancelado">cancelado</option>
                                            }
                                        </select>

                                        <button type="submit" class="admin-action-button admin-action-button--save">
                                            Salvar
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <div class="admin-actions-group">
                                        <a class="admin-action-button admin-action-button--details"
                                               href="/admin/solicitacoes/@s.Id">
                                            Detalhes
                                        </a>

                                        <a class="admin-action-button admin-action-button--whatsapp"
                                               href="/admin/solicitacoes/@s.Id/whatsapp"
                                               target="_blank">
                                            WhatsApp
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</section>