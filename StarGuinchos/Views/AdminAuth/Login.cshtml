@model StarGuinchos.ViewModels.AdminLoginViewModel

@{
    ViewData["Title"] = "Login Administrativo";
    ViewData["Description"] = "Acesso administrativo da StarGuinchos.";
    ViewData["Canonical"] = "https://starguinchos.tech/admin/login";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-auth.css" asp-append-version="true" />
}

<main class="admin-auth-page">
    <section class="admin-auth">
        <div class="container">
            <div class="admin-auth__card">
                <div class="admin-auth__brand">
                    <img src="~/images/logo/logo-footer.png" alt="StarGuinchos" />
                </div>

                <span class="admin-auth__eyebrow">Área administrativa</span>

                <h1 class="admin-auth__title">
                    Acesso restrito
                </h1>

                <p class="admin-auth__text">
                    Entre com as credenciais administrativas para acessar o painel da StarGuinchos.
                </p>

                <form asp-controller="AdminAuth" asp-action="Login" method="post" class="admin-auth__form">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="admin-auth__validation"></div>

                    <div class="admin-auth__group">
                        <label asp-for="Username">Usuário</label>
                        <input asp-for="Username"
                               class="admin-auth__control"
                               autocomplete="username"
                               placeholder="Digite o usuário" />
                        <span asp-validation-for="Username" class="admin-auth__field-error"></span>
                    </div>

                    <div class="admin-auth__group">
                        <label asp-for="Password">Senha</label>
                        <input asp-for="Password"
                               type="password"
                               class="admin-auth__control"
                               autocomplete="current-password"
                               placeholder="Digite a senha" />
                        <span asp-validation-for="Password" class="admin-auth__field-error"></span>
                    </div>

                    <button type="submit" class="admin-auth__button">
                        Entrar no painel
                    </button>
                </form>

                <a asp-controller="Home" asp-action="Index" class="admin-auth__back">
                    Voltar para o site
                </a>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}