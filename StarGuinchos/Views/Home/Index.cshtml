@{
    ViewData["Title"] = "StarGuinchos";
}

<section class="home-hero">
    <header class="home-header">
        <div class="home-header__logo">
            <img src="~/images/logo-star-guinchos.png" alt="Star Guinchos" />
        </div>

        <nav class="home-header__nav">
            <a href="#servicos">Serviços</a>
            <a href="#avaliacoes">Avaliações</a>
            <a href="#area-atendimento">Área de atendimento</a>
            <a href="#contato">Contato</a>
        </nav>
    </header>

    <div class="home-hero__visual">
        <div class="home-hero__image"></div>
        <div class="home-hero__fade"></div>

        <div class="home-hero__card">
            <h1 class="home-hero__title">GUINCHO 24HORAS</h1>
            <p class="home-hero__subtitle">Resgate rápido onde você estiver</p>

            <div class="home-hero__truck">
                <img src="~/images/icone-caminhao.png" alt="Ícone de caminhão" />
            </div>

            <a href="@Url.Action("Create", "Solicitacoes")" class="home-hero__button">
                SOLICITAR AGORA
            </a>
        </div>
    </div>
</section>

<!-- HIGHLIGHTS (AGORA FORA DO HERO) -->
<section class="home-highlights">
    <div class="home-highlights__item">
        <div class="home-highlights__circle">
            <img src="~/images/icone-rapido.png" alt="Atendimento rápido" />
        </div>
        <h2 class="home-highlights__title">RÁPIDO ATENDIMENTO</h2>
        <p class="home-highlights__text">Chegamos em até 30 minutos</p>
    </div>

    <div class="home-highlights__item">
        <div class="home-highlights__circle">
            <img src="~/images/icone-mapa.png" alt="Disponibilidade na região" />
        </div>
        <h2 class="home-highlights__title">DISPONIBILIDADE EM TODA REGIÃO</h2>
        <p class="home-highlights__text">Diversos motoristas parceiros</p>
    </div>

    <div class="home-highlights__item">
        <div class="home-highlights__circle">
            <img src="~/images/icone-24h.png" alt="Serviço 24 horas" />
        </div>
        <h2 class="home-highlights__title">SERVIÇO 24H</h2>
        <p class="home-highlights__text">Atendimento imediato</p>
    </div>
</section>

<section id="servicos" class="home-services">

    <h2 class="home-section__title">NOSSOS SERVIÇOS</h2>

    <div class="home-services__content">

        <div class="home-services__item">
            <img src="~/images/icone-eletrico.png" alt="Pane elétrica" />
            <p>Solução de panes elétricos</p>
        </div>

        <div class="home-services__item">
            <img src="~/images/icone-carro.png" alt="Remoção carro" />
        </div>

        <div class="home-services__or">
            <span>OU</span>
        </div>

        <div class="home-services__item">
            <img src="~/images/icone-moto.png" alt="Remoção moto" />
        </div>

        <div class="home-services__item">
            <img src="~/images/icone-mecanico.png" alt="Mecânico" />
            <p>Reparo imediato ou encaminhamento a oficinas parceiras</p>
        </div>

    </div>

    <div class="home-services__descriptions">
        <p class="home-services__text">
            Remoção segura para qualquer local.
        </p>
    </div>

</section>

<section class="home-steps">

    <h2 class="home-section__title">COMO FUNCIONA</h2>

    <div class="home-steps__content">

        <div class="home-steps__item">
            <span class="home-steps__number">1</span>
            <p class="home-steps__text">FAÇA SUA SOLICITAÇÃO</p>
        </div>

        <div class="home-steps__item">
            <span class="home-steps__number">2</span>
            <p class="home-steps__text">DEFINA ORIGEM E DESTINO</p>
        </div>

        <div class="home-steps__item">
            <span class="home-steps__number">3</span>
            <p class="home-steps__text">ATENDIMENTO IMEDIATO</p>
        </div>

    </div>

</section>

<section id="avaliacoes" class="home-reviews">

    <h2 class="home-section__title">AVALIAÇÕES</h2>

    <div class="home-reviews__grid">

        <div class="home-reviews__card">
            <div class="home-reviews__header">
                <img src="~/images/icone-lampada.png" alt="Ícone" />
                <span>Edna Silva</span>
            </div>
            <p>
                Atendimento rápido, o rapaz foi um anjo na minha vida, estava em uma situação de risco e no fim deu tudo certo.
            </p>
        </div>

        <div class="home-reviews__card">
            <div class="home-reviews__header">
                <img src="~/images/icone-lampada.png" alt="Ícone" />
                <span>Marcos Silva</span>
            </div>
            <p>
                Atendimento rápido, profissional e com preço justo. Recomendo!
            </p>
        </div>

        <div class="home-reviews__card">
            <div class="home-reviews__header">
                <img src="~/images/icone-lampada.png" alt="Ícone" />
                <span>Roberto Almeida</span>
            </div>
            <p>
                Socorro rápido, eficiente e com excelente atendimento do início ao fim.
            </p>
        </div>

        <div class="home-reviews__card">
            <div class="home-reviews__header">
                <img src="~/images/icone-lampada.png" alt="Ícone" />
                <span>Luciana Costa</span>
            </div>
            <p>
                Equipe ágil e atenciosa. Chegaram rápido e prestaram um ótimo serviço!
            </p>
        </div>

    </div>

</section>

<section id="contato" class="home-about">

    <div class="home-about__container">

        <h2 class="home-section__title">SOBRE NÓS</h2>

        <div class="home-about__text">
            <p>
                A StarGuinchos é uma empresa construída ao longo de gerações, fundamentada em dedicação,
                confiança e paixão pelo que faz. Nossa trajetória carrega um legado sólido, moldado pelo
                esforço contínuo e pelo compromisso em oferecer sempre o melhor serviço.
            </p>

            <p>
                Hoje, evoluímos sem abrir mão das nossas raízes. Unimos tradição e inovação para entregar
                soluções eficientes, seguras e ágeis, sempre priorizando a excelência no atendimento e a
                satisfação dos nossos clientes.
            </p>

            <p>
                Mais do que prestar serviços, buscamos ser referência no setor de guinchos, destacando-nos
                pela credibilidade, profissionalismo e pela qualidade que nos acompanham em cada atendimento.
            </p>
        </div>

        <p class="home-about__highlight">
            StarGuinchos — tradição que move, confiança que conduz.
        </p>

    </div>

</section>

<footer class="home-footer">

    <div class="home-footer__container">

        <div class="home-footer__top">
            <img src="~/images/logo-star-guinchos-completa.png" alt="Star Guinchos" />
        </div>

        <div class="home-footer__bottom">

            <p class="home-footer__copyright">
                © StarGuinchos 2026 - TODOS OS DIREITOS RESERVADOS
            </p>

            <div class="home-footer__links">
                <a href="#contato">Contato</a>
                <a href="#">Termos e condições de uso</a>
                <a href="#">Política de privacidade</a>
            </div>

        </div>

    </div>

</footer>