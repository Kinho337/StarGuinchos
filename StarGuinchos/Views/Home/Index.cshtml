@model StarGuinchos.Models.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = "Início";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<main class="home-page">

    <!-- HERO -->
    <section class="home-hero">
        <div class="home-hero__background"></div>
        <div class="home-hero__image-layer"></div>
        <div class="home-hero__overlay"></div>

        <div class="container home-hero__container">
            <div class="home-hero__content">
                <span class="home-hero__badge">Atendimento 24h</span>

                <h1 class="home-hero__title">
                    Guincho 24 horas
                </h1>

                <p class="home-hero__text">
                    Atendimento rápido, seguro e profissional em São Paulo e região.
                </p>

                <div class="home-hero__actions">
                    <a asp-controller="Solicitacoes" asp-action="Create" class="btn-primary-orange home-hero__cta-primary">
                        Solicitar guincho agora
                    </a>

                    <a asp-controller="Home" asp-action="Contato" class="btn-secondary-dark home-hero__cta-secondary">
                        Ligar agora
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- DIFERENCIAIS -->
    <section class="home-differentials" id="servicos">
        <div class="container">
            <div class="home-section-heading">
                <span class="home-section-heading__eyebrow">Nossos diferenciais</span>
                <h2 class="home-section-heading__title">Atendimento pensado para quem precisa de agilidade e confiança</h2>
                <p class="home-section-heading__text">
                    Estruturamos nossos serviços para oferecer rapidez, segurança e suporte em diferentes tipos de atendimento.
                </p>
            </div>

            <div class="home-differentials__grid">
                <article class="home-differentials__card">
                    <div class="home-differentials__icon">
                        <svg class="home-differentials__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14 3H8a2 2 0 0 0-2 2v14l4-2 4 2 4-2 4 2V9l-8-6Z" />
                            <path d="M9 8h6" />
                            <path d="M9 12h6" />
                        </svg>
                    </div>

                    <h3 class="home-differentials__card-title">Nota fiscal para reembolso</h3>
                    <p class="home-differentials__card-text">
                        Emitimos nota fiscal para auxiliar o reembolso do atendimento junto à sua seguradora.
                    </p>
                </article>

                <article class="home-differentials__card">
                    <div class="home-differentials__icon">
                        <svg class="home-differentials__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M14.7 6.3a1 1 0 0 0-1.4 0l-1.2 1.2 4.2 4.2 1.2-1.2a1 1 0 0 0 0-1.4l-2.8-2.8Z" />
                            <path d="M11 8.7 4 15.7V20h4.3l7-7" />
                            <path d="M14 17h6" />
                        </svg>
                    </div>

                    <h3 class="home-differentials__card-title">Pane e suporte mecânico</h3>
                    <p class="home-differentials__card-text">
                        Contamos com oficinas e profissionais parceiros para ampliar as soluções do seu atendimento.
                    </p>
                </article>

                <article class="home-differentials__card">
                    <div class="home-differentials__icon">
                        <svg class="home-differentials__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3l7 3v5c0 5-3.4 8.2-7 10-3.6-1.8-7-5-7-10V6l7-3Z" />
                            <path d="m9.2 12.2 1.8 1.8 3.8-4" />
                        </svg>
                    </div>

                    <h3 class="home-differentials__card-title">Equipe experiente</h3>
                    <p class="home-differentials__card-text">
                        Anos de atuação no ramo com atendimento seguro, responsável e profissional.
                    </p>
                </article>

                <article class="home-differentials__card">
                    <div class="home-differentials__icon">
                        <svg class="home-differentials__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 21s6-5.5 6-11a6 6 0 1 0-12 0c0 5.5 6 11 6 11Z" />
                            <circle cx="12" cy="10" r="2.5" />
                            <path d="M18.5 18.5 22 22" />
                        </svg>
                    </div>

                    <h3 class="home-differentials__card-title">Cobertura ampliada</h3>
                    <p class="home-differentials__card-text">
                        Atendimentos em São Paulo, região e transportes para outras cidades e estados.
                    </p>
                </article>
            </div>

            <div class="home-differentials__footer">
                <a asp-controller="Home" asp-action="Servicos" class="btn-secondary-outline">
                    Ver todos os serviços
                </a>
            </div>
        </div>
    </section>

    <!-- ÁREA DE ATENDIMENTO -->
    <section class="home-coverage" id="area-atendimento">
        <div class="container home-coverage__container">
            <div class="home-coverage__content">
                <div class="home-section-heading home-section-heading--left">
                    <span class="home-section-heading__eyebrow">Cobertura</span>
                    <h2 class="home-section-heading__title">Área de atendimento</h2>
                    <p class="home-section-heading__text">
                        Atendemos São Paulo e região com agilidade, além de realizarmos remoções e transportes sob demanda
                        para outras cidades e estados.
                    </p>
                </div>

                <p class="home-coverage__description">
                    Também buscamos veículos de fora de São Paulo para trazê-los ao estado e, dependendo da necessidade,
                    realizamos serviços de dentro para fora, como transportes para outras localidades, incluindo rotas mais longas.
                </p>

                <div class="home-coverage__tags">
                    <span class="home-coverage__tag">São Paulo e região</span>
                    <span class="home-coverage__tag">Transporte intermunicipal</span>
                    <span class="home-coverage__tag">Transporte interestadual</span>
                    <span class="home-coverage__tag">Serviços sob análise</span>
                </div>

                <div class="home-coverage__actions">
                    <a asp-controller="Home" asp-action="AreaDeAtendimento" class="btn-secondary-outline">
                        Ver área de atendimento completa
                    </a>
                </div>
            </div>

            <div class="home-coverage__map-card">
                <div class="home-coverage__map-placeholder">
                    <!-- Futuramente aqui entra o mapa/API -->
                    <span>Mapa da área de atendimento</span>
                </div>
            </div>
        </div>
    </section>

    <!-- NOSSOS ATENDIMENTOS -->
    <section class="home-services-gallery" id="atendimentos">
        <div class="container">
            <div class="home-section-heading">
                <span class="home-section-heading__eyebrow">Atendimentos reais</span>
                <h2 class="home-section-heading__title">Nossos atendimentos</h2>
                <p class="home-section-heading__text">
                    Alguns registros reais dos serviços prestados pela StarGuinchos.
                </p>
            </div>

            <div class="home-services-gallery__carousel">
                <button type="button" class="home-carousel__arrow home-carousel__arrow--prev" aria-label="Anterior">
                    &#10094;
                </button>

                <div class="home-services-gallery__viewport">
                    <div class="home-services-gallery__track">
                        <article class="home-services-gallery__item">
                            <img src="~/images/atendimentos/atendimento-01.jpg" alt="Atendimento StarGuinchos 1" />
                        </article>

                        <article class="home-services-gallery__item">
                            <img src="~/images/atendimentos/atendimento-02.jpg" alt="Atendimento StarGuinchos 2" />
                        </article>

                        <article class="home-services-gallery__item">
                            <img src="~/images/atendimentos/atendimento-03.jpg" alt="Atendimento StarGuinchos 3" />
                        </article>

                        <article class="home-services-gallery__item">
                            <img src="~/images/atendimentos/atendimento-04.jpg" alt="Atendimento StarGuinchos 4" />
                        </article>
                    </div>
                </div>

                <button type="button" class="home-carousel__arrow home-carousel__arrow--next" aria-label="Próximo">
                    &#10095;
                </button>
            </div>

            <div class="home-services-gallery__footer">
                <a asp-controller="Home" asp-action="Atendimentos" class="btn-secondary-outline">
                    Ver mais atendimentos
                </a>
            </div>
        </div>
    </section>

    <!-- SOBRE NÓS -->
    <section class="home-about" id="sobre">
        <div class="container home-about__container">
            <div class="home-about__content">
                <div class="home-section-heading home-section-heading--left">
                    <span class="home-section-heading__eyebrow">Nossa história</span>
                    <h2 class="home-section-heading__title">Sobre nós</h2>
                </div>

                <div class="home-about__text">
                    <p>
                        A StarGuinchos atua há anos no ramo, construindo sua trajetória com dedicação,
                        confiança e compromisso com cada atendimento.
                    </p>

                    <p>
                        Ao longo do tempo, consolidamos nossa experiência prestando serviços com agilidade,
                        segurança e profissionalismo em diferentes tipos de operação.
                    </p>

                    <p>
                        Mais do que transportar veículos, buscamos entregar tranquilidade, confiança e a
                        certeza de que cada serviço será conduzido com atenção e responsabilidade.
                    </p>
                </div>

                <div class="home-about__stats">
                    <article class="home-about__stat">
                        <strong>10+</strong>
                        <span>Anos de experiência</span>
                    </article>

                    <article class="home-about__stat">
                        <strong>5k+</strong>
                        <span>Atendimentos realizados</span>
                    </article>

                    <article class="home-about__stat">
                        <strong>24/7</strong>
                        <span>Disponibilidade</span>
                    </article>
                </div>

                <div class="home-about__actions">
                    <a asp-controller="Home" asp-action="Sobre" class="btn-secondary-outline">
                        Conheça nossa história
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- AVALIAÇÕES -->
    <section class="home-reviews" id="avaliacoes">
        <div class="container">
            <div class="home-section-heading">
                <span class="home-section-heading__eyebrow">Prova social</span>
                <h2 class="home-section-heading__title">Avaliações</h2>
                <p class="home-section-heading__text">
                    O que nossos clientes dizem sobre nossos serviços.
                </p>
            </div>

            @if (Model.Avaliacoes != null && Model.Avaliacoes.Any())
            {
                <div class="home-reviews__carousel">
                    <button type="button" class="home-carousel__arrow home-carousel__arrow--prev" aria-label="Anterior">
                        &#10094;
                    </button>

                    <div class="home-reviews__viewport">
                        <div class="home-reviews__track">
                            @foreach (var avaliacao in Model.Avaliacoes)
                            {
                                <article class="home-reviews__card">
                                    <div class="home-reviews__stars">
                                        @for (int i = 0; i < avaliacao.Nota; i++)
                                        {
                                            <span>★</span>
                                        }
                                    </div>

                                    <p class="home-reviews__comment">
                                        @avaliacao.Comentario
                                    </p>

                                    <strong class="home-reviews__name">
                                        @avaliacao.Nome
                                    </strong>
                                </article>
                            }
                        </div>
                    </div>

                    <button type="button" class="home-carousel__arrow home-carousel__arrow--next" aria-label="Próximo">
                        &#10095;
                    </button>
                </div>
            }
            else
            {
                <div class="home-reviews__empty">
                    <p class="home-reviews__empty-text">
                        As avaliações aprovadas aparecerão aqui em breve.
                    </p>
                </div>
            }

            <div class="home-reviews__actions">
                <a asp-controller="Avaliacoes" asp-action="Index" class="btn-secondary-outline">
                    Ver todas as avaliações
                </a>

                <a asp-controller="Avaliacoes" asp-action="Create" class="btn-secondary-blue">
                    Avaliar nosso serviço
                </a>
            </div>
        </div>
    </section>

    <!-- CTA FINAL -->
    <section class="home-cta-final">
        <div class="container">
            <div class="home-cta-final__card">
                <h2 class="home-cta-final__title">Precisa de um guincho agora?</h2>

                <p class="home-cta-final__text">
                    Clique no botão abaixo para fazer sua solicitação e receber atendimento imediato.
                </p>

                <div class="home-cta-final__actions">
                    <a asp-controller="Solicitacoes" asp-action="Create" class="btn-primary-orange">
                        Solicitar guincho agora
                    </a>
                </div>

                <p class="home-cta-final__contact">
                    Ou entre em contato pelo telefone: <strong>(11) 99999-9999</strong>
                </p>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}