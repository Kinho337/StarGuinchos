@model StarGuinchos.Models.Solicitacao

<h2>Solicitar Guincho</h2>

<form asp-action="Create" method="post" id="solicitacaoForm">
    @Html.AntiForgeryToken()

    <label>Nome</label>
    <input asp-for="Nome" class="form-control" />

    <label>Telefone</label>
    <input asp-for="Telefone" class="form-control" id="telefone" />
    <span class="field-error" id="telefoneErro"></span>

    <label>Veículo</label>
    <input asp-for="Veiculo" class="form-control" />

    <label>Problema</label>
    <input asp-for="Problema" class="form-control" />

    <div class="form-group location-group">
        <label asp-for="Ponto_partida">Ponto de partida</label>

        <div class="location-input-wrapper">
            <input asp-for="Ponto_partida"
                   class="form-control"
                   id="pontoPartida"
                   autocomplete="off"
                   placeholder="Digite o local de saída" />

            <button type="button" id="usarLocalAtual" class="btn-localizacao">
                Usar localização atual
            </button>
        </div>

        <span class="field-error" id="pontoPartidaErro"></span>
        <div id="pontoPartidaSuggestions" class="autocomplete-list"></div>

        <input type="hidden" id="pontoPartidaLat" name="PontoPartidaLat" />
        <input type="hidden" id="pontoPartidaLng" name="PontoPartidaLng" />
    </div>

    <div class="form-group location-group">
        <label asp-for="Destino">Destino</label>

        <div class="location-input-wrapper">
            <input asp-for="Destino"
                   class="form-control"
                   id="destino"
                   autocomplete="off"
                   placeholder="Digite o destino" />
        </div>

        <span class="field-error" id="destinoErro"></span>
        <div id="destinoSuggestions" class="autocomplete-list"></div>

        <input type="hidden" id="destinoLat" name="DestinoLat" />
        <input type="hidden" id="destinoLng" name="DestinoLng" />
    </div>

    <button type="submit" id="btnSolicitar">Solicitar</button>
</form>

@section Styles {
    <link rel="stylesheet" href="~/css/solicitacao.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/solicitacao.js" asp-append-version="true"></script>
}